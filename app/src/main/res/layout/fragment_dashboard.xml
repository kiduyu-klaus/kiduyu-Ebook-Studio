<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context="com.kiduyu.ebookstudio.MainActivity">

    <LinearLayout
        android:id="@+id/laySubs"
        android:layout_width="match_parent"
        android:layout_centerVertical="true"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginEnd="@dimen/_10px"
        android:layout_marginStart="@dimen/_10px"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/empty_subs_image"/>

        <TextView
            style="@style/txt_OpenSansRomanBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
           android:gravity="center"
            android:layout_marginTop="@dimen/_10px"
            android:text="@string/empty_my_subs"
            android:textColor="@color/subs_title"
            android:textSize="@dimen/_18sp"
            tools:text="@string/empty_my_subs" />

        <TextView
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/_10px"
            android:text="@string/empty_subs_desc"
            android:textColor="@color/home_by_author"
            android:textSize="@dimen/_15sp"
            android:layout_marginBottom="@dimen/_5px"
            tools:text="@string/empty_subs_desc" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStartSubs"
            style="@style/txt_OpenSansRomanBold"
            android:layout_width="wrap_content"
            android:layout_height="43dp"
            android:background="@drawable/rectangle_bg_deep_orange_btn_submit"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_15px"
            android:layout_marginBottom="@dimen/_10px"
            android:singleLine="true"
            android:paddingStart="@dimen/_30px"
            android:paddingEnd="@dimen/_30px"
            android:text="@string/empty_subs_start_btn"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/_15sp"
            tools:text="@string/empty_subs_start_btn" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_8px"
        android:orientation="vertical">
         <TextView
            android:id="@+id/tvSubs"
            style="@style/txt_OpenSansRomanBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_20px"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/my_subs"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_20sp"
            tools:text="@string/my_subs" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20px"
            android:layout_marginTop="@dimen/_20px"
            android:layout_marginEnd="@dimen/_20px"
            android:orientation="horizontal">

            <TextView
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/current_plan"
                android:textColor="@color/subs_title"
                android:textSize="@dimen/_17sp"
                tools:text="@string/current_plan" />

            <TextView
                android:id="@+id/tvPlanName"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="@dimen/_15px"
                android:text="@string/NA"
                android:textColor="@color/subs_title"
                android:textSize="@dimen/_17sp"
                tools:text="@string/current_plan" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20px"
            android:layout_marginTop="@dimen/_10px"
            android:layout_marginEnd="@dimen/_20px"
            android:orientation="horizontal">

            <TextView
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/expired_on"
                android:textColor="@color/subs_title"
                android:textSize="@dimen/_17sp"
                tools:text="@string/expired_on" />

            <TextView
                android:id="@+id/tvPlanDate"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="@dimen/_15px"
                android:text="@string/NA"
                android:textColor="@color/subs_title"
                android:textSize="@dimen/_17sp"
                tools:text="@string/expired_on" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressFav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:theme="@style/ProgressBar" />

    <include
        android:id="@+id/llNoData"
        layout="@layout/no_data_found"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true" />
</RelativeLayout>