<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8px"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.github.siyamed.shapeimageview.CircularImageView
                    android:id="@+id/ivUser"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_portable"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:id="@+id/linear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_15px"
                    android:layout_weight="0.67"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserName"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_10px"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/review_user"
                        android:textSize="@dimen/_16sp"
                        tools:text="@string/app_name" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <com.github.ornolfr.ratingview.RatingView
                            android:id="@+id/ratingView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="@dimen/_8px"
                            app:drawable_empty="@drawable/ic_star_empty"
                            app:drawable_filled="@drawable/ic_star_filled"
                            app:drawable_half="@drawable/ic_star_half"
                            app:drawable_margin="2dp"
                            app:drawable_size="16dp"
                            app:is_indicator="true"
                            app:max_count="5" />

                    <TextView
                        android:id="@+id/tvTime"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_1px"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_10px"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/review_time"
                        android:textSize="@dimen/_12sp"
                        tools:text="52 minute ago" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layOverFlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="@dimen/_10px"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivOverFlowMenu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_3px"
                        android:layout_marginStart="@dimen/_10px"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_more"
                        tools:ignore="ContentDescription"
                        tools:src="@drawable/ic_more" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvReviewMsg"
                style="@style/txt_OpenSansRomanRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5px"
                android:layout_marginEnd="@dimen/_2px"
                android:textColor="@color/review_msg"
                android:textSize="@dimen/_14sp"
                tools:text="@string/app_name" />
        </LinearLayout>

     </LinearLayout>

    <View
        android:id="@+id/vlLine"
        android:layout_width="match_parent"
        android:layout_height="1.4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/_8px"
        android:layout_below="@+id/layMain"
        android:background="@drawable/review_line"
        android:gravity="center" />
</RelativeLayout>