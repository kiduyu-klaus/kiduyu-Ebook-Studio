<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linearBottomMenu"
        style="@style/BottomMenuBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/frameHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageHome"
                android:layout_width="@dimen/_25px"
                android:layout_height="@dimen/_25px"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_15px"
                android:layout_marginEnd="@dimen/_15px"
                android:scaleType="fitXY"
                android:src="@drawable/menu_home"
                tools:ignore="ContentDescription"
                tools:src="@drawable/menu_home" />

            <TextView
                android:id="@+id/tvHome"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bottom_home"
                android:textColor="@color/bottom_menu_bg_normal"
                android:textSize="@dimen/_12sp"
                android:layout_marginTop="@dimen/_5px"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/frameLatest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageLatest"
                android:layout_width="@dimen/_25px"
                android:layout_height="@dimen/_25px"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_15px"
                android:layout_marginEnd="@dimen/_15px"
                android:scaleType="fitXY"
                android:src="@drawable/menu_latest"
                tools:ignore="ContentDescription"
                tools:src="@drawable/menu_latest" />

            <TextView
                android:id="@+id/tvLatest"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bottom_latest"
                android:textColor="@color/bottom_menu_bg_normal"
                android:textSize="@dimen/_12sp"
                android:layout_marginTop="@dimen/_5px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/frameCat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageCat"
                android:layout_width="@dimen/_25px"
                android:layout_height="@dimen/_25px"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_15px"
                android:layout_marginEnd="@dimen/_15px"
                android:scaleType="fitXY"
                android:src="@drawable/menu_cat"
                tools:ignore="ContentDescription"
                tools:src="@drawable/menu_cat" />

            <TextView
                android:id="@+id/tvCat"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bottom_cat"
                android:textColor="@color/bottom_menu_bg_normal"
                android:textSize="@dimen/_12sp"
                android:layout_marginTop="@dimen/_5px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/frameAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageAuthor"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_15px"
                android:layout_marginEnd="@dimen/_15px"
                android:scaleType="fitXY"
                android:src="@drawable/menu_author"
                tools:ignore="ContentDescription"
                tools:src="@drawable/menu_author" />

            <TextView
                android:id="@+id/tvAuthor"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bottom_author"
                android:textColor="@color/bottom_menu_bg_normal"
                android:textSize="@dimen/_12sp"
                android:layout_marginTop="@dimen/_5px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/frameProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageProfile"
                android:layout_width="@dimen/_25px"
                android:layout_height="@dimen/_25px"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_15px"
                android:layout_marginEnd="@dimen/_15px"
                android:scaleType="fitXY"
                android:src="@drawable/menu_profile"
                tools:ignore="ContentDescription"
                tools:src="@drawable/menu_profile" />

            <TextView
                android:id="@+id/tvProfile"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bottom_profile"
                android:textColor="@color/bottom_menu_bg_normal"
                android:textSize="@dimen/_12sp"
                android:layout_marginTop="@dimen/_5px" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>